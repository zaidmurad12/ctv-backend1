{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "composite": false,
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "target": "ES2022",
    "baseUrl": "../..",
    "paths": {
      "@ctv-platform/domain": ["packages/domain/src/index.ts"]
    },
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
