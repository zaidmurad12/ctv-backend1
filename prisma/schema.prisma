generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum ProviderStatusEnum {
  HEALTHY
  UNAVAILABLE
  MAINTENANCE
  DISABLED
  AUTHENTICATION_FAILED
  RATE_LIMITED
  UNKNOWN
}

enum MovieStatusEnum {
  DRAFT
  PENDING
  PUBLISHED
  REMOVED
  INACTIVE
}

enum ImportStatusEnum {
  PENDING
  RUNNING
  PAUSED
  RETRYING
  COMPLETED
  FAILED
  CANCELLED
}

enum SyncStatusEnum {
  PENDING
  RUNNING
  PAUSED
  RETRYING
  COMPLETED
  FAILED
  CANCELLED
}

enum UserRoleEnum {
  ADMIN
  EDITOR
  VIEWER
}

enum ImageTypeEnum {
  POSTER
  BACKDROP
  LOGO
  THUMBNAIL
  STILL
}

enum SettingTypeEnum {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum SourceSiteEnum {
  CEE
  CINEMANA
}

enum SourceKindEnum {
  MOVIE
  SERIES
}

enum SourceMatchStatusEnum {
  PENDING
  MATCHED
  UNMATCHED
  SKIPPED
}

model Provider {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  name             String           
  slug             String            @unique
  version          String           
  baseUrl          String?          
  isEnabled        Boolean           @default(true)
  priority         Int               @default(10)
  healthStatus     ProviderStatusEnum @default(UNKNOWN)
  lastCheck        DateTime?
  lastSyncAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  movieProviders   MovieProvider[]
  tvShowProviders  TVShowProvider[]
  episodeProviders EpisodeProvider[]
  importJobs       ImportJob[]
  syncJobs         SyncJob[]
  @@index([isEnabled, priority])
  @@index([healthStatus])
}

model Movie {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  tmdbId             String?          @unique
  imdbId             String?          @unique
  title              String          
  originalTitle      String?         
  overview           String?         
  // TMDB's own community-contributed Arabic translation when it has one (see
  // extractArabicTranslation in bootstrap-importer.mjs) - free and often already correct, unlike
  // biographyAr which has no such source and needs a real (quota-limited) Gemini call every time.
  // Only actually Gemini-translated as a fallback when TMDB has no Arabic overview on file.
  overviewAr         String?         
  tagline            String?         
  releaseDate        DateTime?
  runtime            Int?
  status             MovieStatusEnum  @default(PENDING)
  rating             Float?
  voteCount          Int              @default(0)
  ageRating          String?         
  originalLanguage   String?         
  poster             String?         
  backdrop           String?         
  logo               String?         
  trailer            String?         
  popularity         Float?
  homepage           String?         
  budget             BigInt?
  revenue            BigInt?
  titleAr            String?         
  // Null = not in the home hero/banner carousel; otherwise its position there (0 = first).
  // Set exclusively through the admin panel's banner-management page - never by the TMDB
  // importer, so re-importing a movie never disturbs a curated banner selection.
  featuredOrder      Int?
  // Admin-chosen CEE/Cinemana entries this title plays from: [{ source: "cee"|"cinemana", nb, kind: "movie"|"series" }].
  // Lets a title be pinned to the right source entry when automatic title matching cannot find it - e.g. a
  // stage play a source lists under its SERIES section (kind "series") although it is a movie here.
  sourceLinks        Json?
  homeSectionItems   HomeSectionItem[]
  // ScheduledImportService's own bookkeeping (see its subtitleBackfill/healthCheck comments) -
  // null until that pass has ever looked at this movie once. Lets each pass rotate through
  // oldest-checked-first and skip a movie it already tried recently, instead of re-searching the
  // same not-found title (or re-probing the same still-dead link) on every single run forever.
  subtitleBackfillCheckedAt DateTime?
  streamHealthCheckedAt     DateTime?
  // Whether this movie was found on CEE/Cinemana by title/IMDb match (see
  // ScheduledImportService's own sourceMatchCheck) - only ever populated for movies with no
  // active stream of their own yet, since a movie that already plays doesn't need this. Null
  // means "not checked yet", not "no match" - the admin list's own filter treats those
  // differently (see AdminListMoviesQueryDto's own comment). Lets the admin panel show which
  // sourceless titles the app can still actually play live (a real source match exists, just
  // never pulled into a stored Stream row) versus which ones are genuinely dead.
  hasSourceMatch            Boolean?
  sourceMatchCheckedAt      DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  collection         Collection?      @relation(fields: [collectionId], references: [id])
  collectionId       String?

  providers          MovieProvider[]
  genres             MovieGenre[]
  companies          MovieCompany[]
  countries          MovieCountry[]
  languages          MovieLanguage[]
  castMembers        MovieCastMember[]
  crewMembers        MovieCrewMember[]
  images             Image[]
  favorites          Favorite[]
  watchHistory       WatchHistory[]
  continueWatching   ContinueWatching[]
  syncIssue          SyncIssue?
  sourceCatalogItems SourceCatalogItem[]
  @@index([title])
  @@index([releaseDate])
  @@index([status])
  @@index([createdAt])
}

model TVShow {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  tmdbId             String?          @unique
  imdbId             String?          @unique
  title              String          
  originalTitle      String?         
  overview           String?         
  // See Movie.overviewAr's own comment - same TMDB-translation-first, Gemini-fallback source.
  overviewAr         String?         
  status             MovieStatusEnum  @default(PENDING)
  releaseDate        DateTime?
  lastAirDate        DateTime?
  numberOfSeasons    Int              @default(0)
  numberOfEpisodes   Int              @default(0)
  rating             Float?
  voteCount          Int              @default(0)
  ageRating          String?         
  originalLanguage   String?         
  poster             String?         
  backdrop           String?         
  logo               String?         
  homepage           String?         
  popularity         Float?
  titleAr            String?         
  // Null = not in the home hero/banner carousel; otherwise its position there (0 = first) -
  // same convention as Movie.featuredOrder (see its own comment), merged with movies' own
  // ordering at read time since the carousel can mix both.
  featuredOrder      Int?
  // Admin-chosen CEE/Cinemana entries this show plays from (see Movie.sourceLinks) - overrides the app's automatic title matching.
  sourceLinks        Json?
  homeSectionItems   HomeSectionItem[]
  // Set by the admin "restructure seasons" tool: this show's season/episode layout was hand-arranged
  // to match the playback sources (e.g. Money Heist as 5 parts, not TMDB's 3 seasons). A TMDB
  // reimport must not rebuild seasons/episodes from TMDB's own grouping while this is true.
  seasonLayoutCustom Boolean          @default(false)
  // Manually marked by an admin after testing in the app (true = plays from a source, false =
  // tested and does not, null = not tested yet) - see Movie.hasSourceMatch.
  hasSourceMatch     Boolean?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  providers          TVShowProvider[]
  genres             TVShowGenre[]
  companies          TVShowCompany[]
  countries          TVShowCountry[]
  languages          TVShowLanguage[]
  seasons            Season[]
  castMembers        TVShowCastMember[]
  crewMembers        TVShowCrewMember[]
  images             Image[]
  favorites          Favorite[]
  watchHistory       WatchHistory[]
  continueWatching   ContinueWatching[]
  sourceCatalogItems SourceCatalogItem[]
  @@index([title])
  @@index([releaseDate])
  @@index([status])
  @@index([createdAt])
}

model Season {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  showId         String
  seasonNumber   Int
  name           String?  
  overview       String?  
  poster         String?  
  airDate        DateTime?
  episodeCount   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  show           TVShow    @relation(fields: [showId], references: [id], onDelete: Cascade)
  episodes       Episode[]

  @@unique([showId, seasonNumber])
  @@index([showId])
  @@index([seasonNumber])
}

model Episode {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  seasonId       String
  episodeNumber  Int
  title          String   
  overview       String?  
  // Fetched via a second per-season TMDB request with language=ar (see importShow in
  // bootstrap-importer.mjs) rather than Gemini - one extra call covers every episode in the
  // season at once, and TMDB frequently already has these for popular shows. Left null (falls
  // back to the English title/overview in the app) when TMDB has no Arabic data for an episode -
  // not Gemini-translated, unlike Movie/TVShow's own overviewAr, since doing that per episode
  // would multiply Gemini's already-tight quota by the show's entire episode count.
  titleAr        String?  
  overviewAr     String?  
  runtime        Int?
  airDate        DateTime?
  rating         Float?
  voteCount      Int       @default(0)
  stillImage     String?  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  season         Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  providers      EpisodeProvider[]
  watchHistory   WatchHistory[]
  continueWatching ContinueWatching[]
  syncIssue      SyncIssue?

  @@unique([seasonId, episodeNumber])
  @@index([seasonId])
  @@index([episodeNumber])
}

model MovieProvider {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  movieId       String
  providerId    String
  externalId    String?  
  sourceTitle   String?  
  sourceUrl     String?  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  movie         Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  provider      Provider  @relation(fields: [providerId], references: [id], onDelete: Restrict)
  streams       Stream[]
  subtitles     Subtitle[]

  @@unique([movieId, providerId])
  @@index([movieId])
  @@index([providerId])
}

model TVShowProvider {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  showId        String
  providerId    String
  externalId    String?  
  sourceTitle   String?  
  sourceUrl     String?  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  show          TVShow    @relation(fields: [showId], references: [id], onDelete: Cascade)
  provider      Provider  @relation(fields: [providerId], references: [id], onDelete: Restrict)
  streams       Stream[]
  subtitles     Subtitle[]

  @@unique([showId, providerId])
  @@index([showId])
  @@index([providerId])
}

model EpisodeProvider {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  episodeId     String
  providerId    String
  externalId    String?  
  sourceTitle   String?  
  sourceUrl     String?  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  episode       Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  provider      Provider  @relation(fields: [providerId], references: [id], onDelete: Restrict)
  streams       Stream[]
  subtitles     Subtitle[]

  @@unique([episodeId, providerId])
  @@index([episodeId])
  @@index([providerId])
}

model Stream {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  movieProviderId    String?
  episodeProviderId  String?
  showProviderId     String?
  quality            String           
  codec              String?          
  language           String?          
  serverName         String?          
  streamUrl          String           
  isDefault          Boolean           @default(false)
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  movieProvider      MovieProvider?    @relation(fields: [movieProviderId], references: [id], onDelete: Cascade)
  episodeProvider    EpisodeProvider?  @relation(fields: [episodeProviderId], references: [id], onDelete: Cascade)
  showProvider       TVShowProvider?   @relation(fields: [showProviderId], references: [id], onDelete: Cascade)

  @@index([movieProviderId])
  @@index([episodeProviderId])
  @@index([showProviderId])
  @@index([isActive])
  @@index([quality])
  @@index([language])
}

model Subtitle {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  movieProviderId    String?
  episodeProviderId  String?
  showProviderId     String?
  language           String           
  format             String           
  url                String           
  isDefault          Boolean           @default(false)
  // Set only for subtitles resolved through OpenSubtitles (see OpenSubtitlesService) - their
  // download links expire quickly, so `url` here points at this backend's own stable
  // /subtitles/:id/resolve redirect instead of a temporary OpenSubtitles link. That endpoint
  // re-resolves a fresh download link from OpenSubtitles using this file id every time the app
  // actually calls it, rather than this server ever downloading/storing the subtitle file
  // itself. Manually admin-added subtitles leave this null and use `url` directly as-is.
  externalFileId     String?          
  // Last real OpenSubtitles download link resolved for externalFileId, plus when. Used two
  // ways: (1) skip re-resolving (and burning OpenSubtitles' daily download quota) if the cached
  // link is still within RESOLVE_CACHE_TTL of subtitles.controller.ts; (2) serve as a fallback
  // when a fresh resolve fails (quota exhausted, network error) so playback still gets *a*
  // working link instead of the resolve endpoint redirecting to itself - the actual cause of
  // subtitles silently never appearing in the app despite the row existing.
  resolvedUrl        String?          
  // The actual subtitle file contents, fetched once and kept forever. OpenSubtitles' free-tier
  // key gets an observed daily *download* quota in the single digits (~5-10), completely
  // separate from - and far smaller than - its search quota; re-resolving the same file every
  // RESOLVE_CACHE_TTL (6h) burns a fresh unit each time, so a handful of viewers spread across
  // one day already exhausts it and every other title 502s until the quota resets at UTC
  // midnight. Since resolveDownloadLink's link is the only quota-limited step - fetching the
  // text from it isn't - persisting that text here means each externalFileId ever costs the
  // quota exactly once, for its entire lifetime, not once per cache window.
  resolvedContent    String?
  // Sampled at several points across the runtime (not just two) by audioSyncAnalysisService.ts,
  // right after this row is created (import/hash-match/manual upload - see its own call sites) -
  // each entry is `{ tMs, offsetMs }`, the real detected correction *at that point in the video*,
  // sorted ascending by tMs. The app interpolates between the two nearest anchors instead of
  // applying one constant offset+speed pair everywhere (see VideoPlayer.tsx's correctedSubtitleTime
  // usage) - a single global linear fit (the old defaultOffsetMs/defaultSpeed below) can only ever
  // be right at one moment or drift smoothly; it can't represent a subtitle that's fine for a while
  // and then jumps to a different fixed offset, which is exactly what a subtitle authored for a
  // *different cut* of the same title (a trimmed/extended intro, an inserted/removed recap or ad
  // break) produces - reported as "matches in one part of the movie, not another." Null until
  // analysis has run at least once, or if every sample point failed to find a confident match.
  syncAnchors        Json?
  // The single-point/single-line predecessor to syncAnchors above - kept only as a legacy
  // fallback for whatever a subtitle's own analysis hasn't been (or couldn't be) computed as
  // anchors for (see VideoPlayer.tsx: used only when syncAnchors is null/empty). New analyses
  // still populate this too - defaultOffsetMs mirrors the first anchor, defaultSpeed stays 1 -
  // purely so nothing still reading these two fields directly (e.g. an admin panel display) sees
  // a stale, no-longer-produced value.
  defaultOffsetMs    Int               @default(0)
  defaultSpeed       Float             @default(1)
  // "pending" until the (fire-and-forget, can take a minute or two) analysis finishes -
  // "done"/"failed" after. Lets the admin panel show real status instead of a defaultOffsetMs of
  // 0 being ambiguous with "analyzed and genuinely no correction needed."
  syncAnalysisStatus String            @default("pending")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  movieProvider      MovieProvider?    @relation(fields: [movieProviderId], references: [id], onDelete: Cascade)
  episodeProvider    EpisodeProvider?  @relation(fields: [episodeProviderId], references: [id], onDelete: Cascade)
  showProvider       TVShowProvider?   @relation(fields: [showProviderId], references: [id], onDelete: Cascade)

  @@index([movieProviderId])
  @@index([episodeProviderId])
  @@index([showProviderId])
  @@index([language])
  @@index([isDefault])
}

// One row per movie/episode, upserted (not appended) each time the app's own audio-sync feature
// confidently detects a real timing mismatch on a device (see VideoPlayer.tsx's onAutoSync) -
// "أعمال ترجمتها غير متطابقة" (works whose subtitle doesn't match), surfaced in the admin panel's
// own dedicated tab so an admin can fix the underlying subtitle once (upload/hash-match) instead
// of every viewer silently working around it locally. `resolved` is cleared back to false on any
// new report even after being marked resolved once - a repeat complaint after a fix means the fix
// didn't actually hold (or was for a different release), not that it's safe to ignore again.
model SyncIssue {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  movieId         String?  @unique
  episodeId       String?  @unique
  offsetMs        Int
  speed           Float    @default(1)
  reportCount     Int      @default(1)
  firstReportedAt DateTime @default(now())
  lastReportedAt  DateTime @updatedAt
  resolved        Boolean  @default(false)

  movie           Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episode         Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([resolved])
}

model Genre {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  tmdbId        String?          @unique
  name          String           @unique
  slug          String           @unique

  movies        MovieGenre[]
  shows         TVShowGenre[]
}

model Collection {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  tmdbId        String?   @unique
  title         String   
  overview      String?  
  poster        String?  
  backdrop      String?  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  movies        Movie[]

  @@index([title])
}

model Person {
  id            String               @id @default(auto()) @map("_id") @db.ObjectId
  tmdbId        String?              @unique
  name          String              
  birthday      DateTime?
  deathday      DateTime?
  biography     String?             
  // Gemini-translated from `biography` - TMDB itself rarely has an Arabic translation for a
  // person's biography specifically (unlike a movie's own title/overview, which usually does).
  biographyAr   String?             
  // TMDB's own free-text field (e.g. "Los Angeles, California, USA") - not normalized to a
  // Country row like Movie/TVShow's own production countries, since a person's birthplace is
  // display-only here and TMDB doesn't return it in a structured form worth splitting up.
  placeOfBirth  String?             
  photo         String?             
  popularity    Float?
  // How many times prisma/backfill-person-details.mjs has checked this row and found nothing on
  // TMDB (see that script's own comment) - most of these never actually gain a detail later, so
  // retrying forever just burns that script's run budget on rows that will realistically never
  // change. Capped at MAX_ATTEMPTS there instead of retried indefinitely; untouched once a real
  // fetch succeeds, since the row stops matching that script's own "all three still null" filter
  // at that point regardless of this count.
  detailFetchAttempts Int            @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  movieCast     MovieCastMember[]
  movieCrew     MovieCrewMember[]
  showCast      TVShowCastMember[]
  showCrew      TVShowCrewMember[]

  @@index([name])
  @@index([popularity])
}

model Company {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  tmdbId        String?   @unique
  name          String   
  logo          String?  
  country       String?  
  homepage      String?  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  movies        MovieCompany[]
  shows         TVShowCompany[]

  @@index([name])
}

model Country {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  isoCode       String    @unique
  name          String   
  nativeName    String?  

  movies        MovieCountry[]
  shows         TVShowCountry[]

  @@index([name])
}

model Language {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  isoCode       String    @unique
  englishName   String   
  nativeName    String?  
  rtl           Boolean   @default(false)

  movies        MovieLanguage[]
  shows         TVShowLanguage[]

  @@index([englishName])
}

model Image {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  movieId       String?
  showId        String?
  type          ImageTypeEnum
  width         Int?
  height        Int?
  url           String       
  provider      String       
  createdAt     DateTime      @default(now())

  movie         Movie?        @relation(fields: [movieId], references: [id], onDelete: Cascade)
  show          TVShow?       @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@index([movieId])
  @@index([showId])
  @@index([type])
}

model ImportJob {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  providerId    String
  status        ImportStatusEnum @default(PENDING)
  startedAt     DateTime?
  finishedAt    DateTime?
  processed     Int              @default(0)
  failed        Int              @default(0)
  logs          String?         
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  provider      Provider         @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([providerId])
  @@index([status])
  @@index([createdAt])
}

model SyncJob {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  providerId       String
  startedAt        DateTime?
  finishedAt       DateTime?
  status           SyncStatusEnum @default(PENDING)
  newMovies        Int            @default(0)
  updatedMovies    Int            @default(0)
  failedMovies     Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  provider         Provider       @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([providerId])
  @@index([status])
  @@index([createdAt])
}

// One row per distinct (source, kind, nb) ever seen while paging cee.buzz's or
// cinemana.shabakaty.com's own AdvancedSearch?videoTitle=&page=N catalog browse (an empty
// videoTitle returns every title on that source, not a search result - see ScheduledImportService).
// Discovery (cheap, paged metadata only) and enrichment (TMDB match + import + stream/subtitle
// attach, quota-limited) are two separate steps precisely so this table can hold "known about but
// not yet processed" state - that split is what makes backlog catch-up and steady-state "just new
// releases" the same code path with no explicit mode flag (see ScheduledImportService's own comment).
model SourceCatalogItem {
  id             String                 @id @default(auto()) @map("_id") @db.ObjectId
  source         SourceSiteEnum
  kind           SourceKindEnum
  nb             String                
  enTitle        String?               
  arTitle        String?               
  year           Int?
  // Extracted from the listing's imdbUrlRef via the same regex CinemanaTVRN's extractImdbId
  // uses - null when the source item has no imdbUrlRef at all, which is when the fuzzy
  // title-similarity fallback runs instead of the exact TMDB find-by-imdb lookup.
  imdbId         String?               
  status         SourceMatchStatusEnum  @default(PENDING)
  matchMethod    String?               
  matchScore     Int?
  matchedMovieId String?
  matchedShowId  String?
  attempts       Int                    @default(0)
  lastAttemptAt  DateTime?
  // Null while PENDING/MATCHED/SKIPPED; set only on UNMATCHED, to lastAttemptAt plus the
  // configured retry window - re-checked by every enrichment pass's UNMATCHED query so a title
  // with no TMDB match today isn't skipped forever, just deferred.
  nextRetryAt    DateTime?
  discoveredAt   DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  matchedMovie   Movie?                 @relation(fields: [matchedMovieId], references: [id], onDelete: SetNull)
  matchedShow    TVShow?                @relation(fields: [matchedShowId], references: [id], onDelete: SetNull)

  @@unique([source, kind, nb])
  @@index([status, nextRetryAt])
  @@index([imdbId])
  @@index([matchedMovieId])
  @@index([matchedShowId])
}

// One row per (source, kind) - 4 total (cee-movie, cee-series, cinemana-movie, cinemana-series).
// nextPage is the next AdvancedSearch page to request; caughtUp flips true the first time a page
// comes back empty, and the sweep keeps re-requesting exactly that same page on every future run
// (one cheap request) until the source catalog grows again and it stops being empty.
model SourceCatalogCursor {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  source      SourceSiteEnum
  kind        SourceKindEnum
  nextPage    Int            @default(1)
  caughtUp    Boolean        @default(false)
  lastSweptAt DateTime?
  updatedAt   DateTime       @updatedAt

  @@unique([source, kind])
}

// Progress bookkeeping for ScheduledImportService's TMDB-first popularity import (independent of
// CEE/Cinemana entirely - see its own comment). One row per (kind, language bucket): nextPage is
// the next TMDB /discover page (popularity-sorted) to consume; wraps back to 1 once TMDB's own
// 500-page cap or an empty page is hit, so a later run re-scans and picks up anything newly popular.
model TmdbDiscoveryCursor {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  kind      SourceKindEnum
  bucket    String        
  nextPage  Int            @default(1)
  updatedAt DateTime       @updatedAt

  @@unique([kind, bucket])
}

model User {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  email         String           @unique
  username      String           @unique
  passwordHash  String          
  roleId        String
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  role          Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  favorites     Favorite[]
  watchHistory  WatchHistory[]
  continueWatching ContinueWatching[]
  refreshTokens RefreshToken[]
  @@index([isActive])
}

model RefreshToken {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
