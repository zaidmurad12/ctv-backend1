// The home screen's rows, fully admin-managed: order, visibility, titles, and what fills each one.
// RECENT/POPULAR/TOP_RATED/SERIES are computed live from the catalog (same lists the app always
// built itself); CUSTOM rows hold an explicit, ordered item list - hand-picked, or imported from a
// TMDB list/preset/discover query (see HomeSectionsAdminService). No rows at all = the app falls
// back to those four defaults.
enum HomeSectionKindEnum {
  RECENT
  POPULAR
  TOP_RATED
  SERIES
  CUSTOM
  // A rule-driven row: "newest / top-rated / most-popular movies (or shows) in language X" - computed live
  // from the catalog on every request, so it always reflects what is actually there (see HomeSection.rule).
  RULE
}

model HomeSection {
  id           String              @id @default(auto()) @map("_id") @db.ObjectId
  kind         HomeSectionKindEnum @default(CUSTOM)
  titleAr      String             
  titleEn      String             
  sortOrder    Int                 @default(0)
  isVisible    Boolean             @default(true)
  maxItems     Int                 @default(20)
  // Only for kind RULE: { media: "movie"|"series"|"all", sort: "newest"|"rating"|"popularity", language?, genre?, minVotes? }
  rule         Json?
  // Import bookkeeping for CUSTOM rows filled from TMDB (importStatus: IMPORTING | DONE | FAILED).
  importSource String?            
  importStatus String?            
  importTotal  Int                 @default(0)
  importDone   Int                 @default(0)
  importError  String?            
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  items        HomeSectionItem[]

  @@index([sortOrder])
}

model HomeSectionItem {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  sectionId String
  movieId   String?
  showId    String?
  position  Int

  section   HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  movie     Movie?      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  show      TVShow?     @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@index([sectionId, position])
}
